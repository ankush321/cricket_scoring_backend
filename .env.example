# Copy to .env and adjust. .env is git-ignored and is read by `docker compose` and `./gradlew run`.
# Real environment variables always win over values in this file.

# --- Database (local docker-compose Postgres) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cricket_scoring
DB_USER=cricket
DB_PASSWORD=cricket
# Alternatively set one URL; it takes precedence over DB_HOST/DB_PORT/DB_NAME:
# DATABASE_URL=postgres://cricket:cricket@localhost:5433/cricket_scoring?sslmode=disable

# --- Auth (local-only values; production uses `fly secrets set`) ---
JWT_SECRET=dev-only-change-me
# HMAC key for stored OTP hashes; required when WHATSAPP_OTP_MODE=cloud
OTP_PEPPER=dev-only-otp-pepper
# Access tokens last 15 min by default; see README for the session/refresh settings.
# ACCESS_TOKEN_TTL_SECONDS=900
# GOOGLE_CLIENT_IDS=android-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.example.cricket
# Apple token revocation on account deletion (all four or none):
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_TOKEN_ENCRYPTION_KEY=   # openssl rand -base64 32
WHATSAPP_OTP_MODE=console
# Beta rollout and abuse limits (see README for all of them):
# WHATSAPP_OTP_ROLLOUT=on            # off | allowlist | on
# WHATSAPP_OTP_ALLOWLIST=+9198765
# WHATSAPP_ALLOWED_COUNTRY_CODES=91
# OTP_DAILY_SEND_BUDGET=2000
# WHATSAPP_APP_SECRET=               # delivery webhook signature
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
